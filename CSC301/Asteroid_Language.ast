-- 33
function isprime with x do
    if x >= 2 do
        for y in range(2,x) do
            if math @mod(x,y) == 0 do
                return false.
            end
        end
    else do
        return false.
    end
    return true.
end

io @println (isprime 17).
io @println (isprime 15).

assert (isprime(17)).
assert (not isprime(15)).

